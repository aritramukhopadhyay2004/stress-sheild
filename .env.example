# .env.example — copy to .env and fill in secrets (do NOT commit real secrets)

# -------------------------
# Backend
# -------------------------
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# -------------------------
# Frontend (Vite) - prefix VITE_ to expose to client
# -------------------------
VITE_BACKEND_URL=http://localhost:5000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# -------------------------
# ML service
# -------------------------
ML_SERVICE_PORT=8000
MODEL_PATH=./model

# -------------------------
# Notes
# -------------------------
# - Copy this file to .env in the repo root for local development.
# - For deployment, set these values in your hosting/CI environment (Vercel, Docker, Cloud Run, etc.) instead of checking them into source control.
# - If you use Docker Compose, values from the .env file will be available to services.
